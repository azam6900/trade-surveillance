<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
	  	<groupId>org.springframework.boot</groupId>
	  	<artifactId>spring-boot-starter-parent</artifactId>
	  	<version>4.1.2</version>
		<relativePath/>
	</parent>
	<groupId>com.webworks</groupId>
	<artifactId>trade-surveillance</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>trade-surveillance</name>
	<properties>
		<java.version>21</java.version>
		<jackson-bom.version>3.1.8</jackson-bom.version>
		<jackson-2-bom.version>2.21.8</jackson-2-bom.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.apache.kafka</groupId>
			<artifactId>kafka-coordinator-common</artifactId>
			<version>4.2.2</version>
			<scope>compile</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>8</source>
					<target>8</target>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<modules>
		<module>services/alert-case-service</module>
		<module>libs/trade-common</module>
		<module>services/ingestion-service</module>
		<module>services/detection-service</module>

		<!-- uncomment each module when added 

	  <module>services/gateway</module>
	  -->
	</modules>
</project>